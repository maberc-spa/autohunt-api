{
  "info": {
    "name": "AutoHunt API",
    "description": "CRUD para vehículos, mantenimientos y catálogos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"password123\",\n  \"countryId\": 1\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@autohunt.dev\",\n  \"password\": \"demo12345\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{base_url}}/api/health" } },
        { "name": "Readiness", "request": { "method": "GET", "url": "{{base_url}}/api/health/ready" } },
        { "name": "Liveness", "request": { "method": "GET", "url": "{{base_url}}/api/health/live" } }
      ]
    },
    {
      "name": "Countries",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/countries" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Chile\",\n  \"code\": \"CHL\"\n}" },
            "url": "{{base_url}}/api/countries"
          }
        }
      ]
    },
    {
      "name": "Brands",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/brands" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Toyota\",\n  \"countryId\": 1\n}" },
            "url": "{{base_url}}/api/brands"
          }
        }
      ]
    },
    {
      "name": "Models",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/models" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Corolla\",\n  \"brandId\": 1\n}" },
            "url": "{{base_url}}/api/models"
          }
        }
      ]
    },
    {
      "name": "Vehicle Types",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/vehicle-types" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sedan\",\n  \"description\": \"Automóvil de turismo\"\n}" },
            "url": "{{base_url}}/api/vehicle-types"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/users" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"password123\",\n  \"countryId\": 1\n}"
            },
            "url": "{{base_url}}/api/users"
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/vehicles" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"brandId\": 1,\n  \"modelId\": 1,\n  \"vehicleTypeId\": 1,\n  \"year\": 2024,\n  \"mileage\": 15000\n}"
            },
            "url": "{{base_url}}/api/vehicles"
          }
        }
      ]
    },
    {
      "name": "Maintenance Types",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/maintenance-types" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cambio de aceite\",\n  \"description\": \"Reemplazo de aceite y filtro\"\n}"
            },
            "url": "{{base_url}}/api/maintenance-types"
          }
        }
      ]
    },
    {
      "name": "Maintenances",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/maintenances" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"performedAt\": \"2024-06-15T10:00:00.000Z\",\n  \"mileageAtService\": 16000,\n  \"totalCost\": 89.99\n}"
            },
            "url": "{{base_url}}/api/maintenances"
          }
        }
      ]
    },
    {
      "name": "User Maintenances",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/user-maintenances" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"maintenanceId\": 1,\n  \"role\": \"OWNER\"\n}" },
            "url": "{{base_url}}/api/user-maintenances"
          }
        }
      ]
    },
    {
      "name": "Maintenance Details",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{base_url}}/api/maintenance-details" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maintenanceId\": 1,\n  \"maintenanceTypeId\": 1,\n  \"description\": \"Aceite sintético\",\n  \"cost\": 45.50,\n  \"quantity\": 1\n}"
            },
            "url": "{{base_url}}/api/maintenance-details"
          }
        }
      ]
    }
  ]
}
