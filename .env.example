# Copia este archivo: cp .env.example .env

# Neon (recomendado)
# En https://console.neon.tech → tu proyecto → Connect:
#   - "Pooled connection"  → DATABASE_URL
#   - "Direct connection"  → DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# PostgreSQL local (alternativa)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autohunt"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autohunt"

PORT=3000
NODE_ENV=development

# Auth JWT (genera uno seguro: openssl rand -base64 32)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Rate limiting (opcional)
# RATE_LIMIT_PUBLIC_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_MAX=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_VIN_WINDOW_MS=900000
# RATE_LIMIT_VIN_MAX=30

# Mailer externo (2FA / notificaciones)
# MAILER_BASE_URL=https://api.mailer.example.com
# MAILER_API_KEY=your-api-key

# URL pública de la API (presigned uploads / downloads)
# API_PUBLIC_URL=https://autohunt-api.onrender.com

# Administrador inicial (opcional). Al arrancar, si ADMIN_EMAIL existe se
# promueve a ADMIN; si no existe, se crea con ADMIN_PASSWORD (mín. 8 caracteres).
# ADMIN_EMAIL=admin@autohunt.cl
# ADMIN_PASSWORD=change-me
# ADMIN_USERNAME=admin

# Catálogo de vehículos (auto-db-api). autohunt-api es la única puerta de entrada.
# En el mismo servidor puedes usar la red interna de Docker en vez del dominio público:
#   CATALOG_API_URL=http://vehicle-catalog-api:3000
# CATALOG_API_URL=https://auto-db-api.maberc.com
# = CLIENT_API_KEY de auto-db-api (acceso a /v1)
# CATALOG_API_KEY=
# = ADMIN_API_KEY de auto-db-api (habilita /api/admin/catalog/*)
# CATALOG_ADMIN_API_KEY=
# CATALOG_TIMEOUT_MS=8000
# RATE_LIMIT_CATALOG_WINDOW_MS=900000
# RATE_LIMIT_CATALOG_MAX=300
# RATE_LIMIT_CATALOG_SUBMISSION_WINDOW_MS=3600000
# RATE_LIMIT_CATALOG_SUBMISSION_MAX=10
